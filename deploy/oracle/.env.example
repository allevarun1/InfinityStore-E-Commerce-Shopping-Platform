# Settings for the API on the Oracle server. setup-server.sh copies this to .env (chmod 600). Never commit .env.
#
# HOW TO FILL IT: open Render > rekha-shopping-mall-api > Environment, and copy every value that is set there into
# the matching line below. Lines marked [RENDER] must be copied exactly, or something breaks:
#   - JWT_SECRET different  -> every shopper and the admin is signed out.
#   - COD / SHIPPING lines missing -> the app falls back to its defaults (COD ON, Rs 49 shipping, free above Rs 999),
#     which are NOT what the live shop uses.
# Empty lines: fine for settings that are empty by default (keys, tokens). For anything with a built-in default,
# comment the line out rather than leaving it empty.
# Passwords you make up here: use `openssl rand -hex 24` (letters and digits only; a "$" breaks Docker Compose).

# ------------------------------------------------------------------ server (new, not on Render)
# Which compose files run. Phase A: database stays on Aiven. migrate-db.sh switches it to Phase B for you.
COMPOSE_FILE=docker-compose.yml
# The API's address, e.g. api.rekhashoppingmall.in. Its DNS A record must point at this server (Cloudflare: grey cloud).
API_DOMAIN=api.example.com
# Java memory: the container has 3 GB. Do not copy Render's JAVA_TOOL_OPTIONS (it limits the JIT to save RAM).
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC -Xss512k

# ------------------------------------------------------------------ database
# Phase A: the Aiven values from Render. [RENDER]
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Lets the API switch Aiven's free database back on when Aiven powers it off. [RENDER] Remove after Phase B.
AIVEN_API_TOKEN=
DDL_AUTO=update
# Phase B (MySQL on this server): make up two passwords now; migrate-db.sh uses them.
LOCAL_DB_PASSWORD=
LOCAL_DB_ROOT_PASSWORD=

# ------------------------------------------------------------------ security and accounts
APP_ENV=production
# [RENDER] Same value, or everyone is signed out.
JWT_SECRET=
ADMIN_USERNAME=admin
# [RENDER if set] Also receives the daily digest. Must not be left empty: comment it out instead.
# ADMIN_EMAIL=
# [RENDER]
ADMIN_PASSWORD=
# Only loads the built-in sarees while the database has no categories; never overwrites. [RENDER]
SEED_DEMO_CATALOG=true

# ------------------------------------------------------------------ the shop's web addresses
# Every address the shop is opened from, comma separated. Add your own domain (https://www.<domain>) when it is live.
CORS_ORIGINS=https://rekha-shopping-mall.pages.dev
# Used in emails and payment links.
FRONTEND_URL=https://rekha-shopping-mall.pages.dev

# ------------------------------------------------------------------ payments (Razorpay) [RENDER]
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Also add the webhook https://<API_DOMAIN>/api/payments/razorpay/webhook in Razorpay with this same secret.
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=false

# ------------------------------------------------------------------ prices and delivery [RENDER]
FREE_SHIPPING_THRESHOLD=0
SHIPPING_FEE=99
DEFAULT_GST_PERCENT=0
PRICING_CURRENCY=INR
WELCOME_CODE=WELCOME10
# Delivery estimates: keep these commented out to use the built-in values. Uncomment only the ones Render has.
# (A line that is present but empty REPLACES the built-in value with nothing.)
# DELIVERY_METRO_PREFIXES=11,30,38,40,41,50,56,60,70
# DELIVERY_REMOTE_PREFIXES=18,19,74,78,79,90
# DELIVERY_BLOCKED_PREFIXES=
# DELIVERY_NO_COD_PREFIXES=
# DELIVERY_METRO_DAYS=3-5
# DELIVERY_REMOTE_DAYS=8-12
# DELIVERY_DEFAULT_DAYS=5-8
# DELIVERY_DISPATCH_DAYS=1

# ------------------------------------------------------------------ photos and videos (Cloudflare R2) [RENDER]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The storefront address (its /media function reads the bucket), not an r2.dev address.
R2_PUBLIC_URL=https://rekha-shopping-mall.pages.dev

# ------------------------------------------------------------------ sign-in [RENDER]
GOOGLE_CLIENT_ID=1095864064515-vqa19ftl6s24kuih70g2tan8n7a9u3bu.apps.googleusercontent.com
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
PHONE_LOGIN_ENABLED=false
TRUECALLER_APP_KEY=
TRUECALLER_APP_NAME=Rekha Shopping Mall
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=login_otp
WHATSAPP_OTP_LANGUAGE=en
# Paid-order WhatsApp messages (templates new_order_alert + order_confirmed, see docs/WHATSAPP_ORDER_ALERTS.md)
ORDER_ALERT_WHATSAPP=
WHATSAPP_NOTIFY_OWNER=true
WHATSAPP_NOTIFY_CUSTOMER=true
# Owner email for every new paid order (defaults to STORE_SUPPORT_EMAIL)
ORDER_ALERT_EMAIL=

# ------------------------------------------------------------------ email (Gmail app password) [RENDER]
MAIL_USERNAME=
MAIL_PASSWORD=
# DIGEST_EMAIL=   (defaults to ADMIN_EMAIL)

# ------------------------------------------------------------------ store details shown to shoppers [RENDER if set]
STORE_NAME=Rekha Shopping Mall
STORE_WHATSAPP=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# ------------------------------------------------------------------ automation and AI [RENDER if set]
AUTOMATION_ENABLED=true
AUTOMATION_ZONE=Asia/Kolkata
AI_PROVIDER=none
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ off-server backups (backup.sh)
# Oracle Object Storage through its S3-compatible API. In the Oracle console: create a private bucket
# (e.g. rekha-backups), then Profile > Customer secret keys > Generate. Namespace: Tenancy details page.
# Endpoint format: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-mumbai-1
BACKUP_S3_BUCKET=rekha-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Optional: a free healthchecks.io check URL. It emails you if a nightly backup fails or does not run.
BACKUP_PING_URL=
