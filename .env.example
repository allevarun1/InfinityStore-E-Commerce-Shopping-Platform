# Backend (Railway service: backend) -------------------------------------
# Reference the MySQL service Railway creates for you.
DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Any long random string (64+ chars). Never reuse the local demo value.
JWT_SECRET=change-me-to-a-long-random-secret

# Comma separated browser origins allowed to call the API.
# Set this to your deployed frontend URL, e.g. https://frontend-production-xxxx.up.railway.app
CORS_ORIGINS=https://your-frontend.up.railway.app

# Seed accounts created on first boot against an empty database.
# Set these before the first deploy - the seeder only runs when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=use-a-long-random-password-here
CUSTOMER_USERNAME=customer
CUSTOMER_EMAIL=customer@yourdomain.com
CUSTOMER_PASSWORD=use-a-long-random-password-here

# Optional - order confirmation emails. Use a Gmail App Password, not your login password.
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend (Railway service: frontend) -----------------------------------
# Must include the /api suffix. Baked in at BUILD time - redeploy after changing.
VITE_API_URL=https://your-backend.up.railway.app/api
