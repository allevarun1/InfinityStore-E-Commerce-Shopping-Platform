# Backend (Railway service: backend) -------------------------------------
# Reference the MySQL service Railway creates for you.
DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# REQUIRED. A random value of 32+ characters. The app refuses to start in production without it.
JWT_SECRET=generate-with-openssl-rand-base64-48

# REQUIRED. Comma separated browser origins allowed to call the API (no wildcard).
# e.g. https://frontend-production-xxxx.up.railway.app
CORS_ORIGINS=https://your-frontend.up.railway.app

# Optional. Public storefront URL used in emailed password-reset links.
# Defaults to the first CORS_ORIGINS entry.
FRONTEND_URL=

# REQUIRED on first boot. 10+ characters, not a default value. The seeder keeps the admin
# password in step with this variable on every start.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=use-a-long-random-password-here

# Optional demo customer, only created when CUSTOMER_PASSWORD is set. Leave blank in production.
CUSTOMER_USERNAME=customer
CUSTOMER_EMAIL=customer@yourdomain.com
CUSTOMER_PASSWORD=

# Sample sarees for local development. Must stay false (or unset) in production.
SEED_DEMO_CATALOG=false

# Payments: "none" = cash on delivery only (default). Real gateway adapters are not built yet.
# "test" is a non-production adapter and is REFUSED when APP_ENV=production.
PAYMENT_PROVIDER=none

# Leave unset in production. Set APP_ENV=dev only on a developer machine (or use SPRING_PROFILES_ACTIVE=dev).
# APP_ENV=production

# Pricing (catalogue prices are tax-exclusive). Confirm GST rates with your accountant;
# a per-product gstPercent overrides the default.
DEFAULT_GST_PERCENT=18
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=49

# Optional - order and password-reset emails. Use a Gmail App Password, not your login password.
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend (Railway service: frontend) -----------------------------------
# Must include the /api suffix. Baked in at BUILD time - redeploy after changing.
VITE_API_URL=https://your-backend.up.railway.app/api

# Optional. Support address shown in the storefront footer (hidden when unset). Baked in at build time.
VITE_SUPPORT_EMAIL=
